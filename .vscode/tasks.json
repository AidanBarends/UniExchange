{
  // Ctrl/Cmd+Shift+P -> "Tasks: Run Task"
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend: install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/Frontend" },
      "problemMatcher": [],
      "detail": "Install frontend dependencies (run this once after cloning)"
    },
    {
      "label": "frontend: dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/Frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" },
      "detail": "Vite dev server on http://localhost:5173"
    },
    {
      "label": "frontend: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/Frontend" },
      "group": "build",
      "problemMatcher": ["$tsc"],
      "detail": "Type-check and bundle into Frontend/dist"
    },
    {
      "label": "frontend: lint",
      "type": "shell",
      "command": "npm run lint",
      "options": { "cwd": "${workspaceFolder}/Frontend" },
      "problemMatcher": ["$eslint-stylish"],
      "detail": "ESLint over the whole frontend"
    },
    {
      "label": "backend: test",
      "type": "shell",
      // sh ./mvnw rather than ./mvnw so it works even if the file lost its
      // executable bit (a common surprise after cloning on Windows).
      "command": "sh ./mvnw test",
      "windows": { "command": ".\\mvnw.cmd test" },
      "options": { "cwd": "${workspaceFolder}/Backend" },
      "group": "test",
      "problemMatcher": ["$maven"],
      "detail": "67 tests, H2 in-memory - needs no MySQL and no SMTP"
    },
    {
      "label": "backend: build",
      "type": "shell",
      "command": "sh ./mvnw clean package -DskipTests",
      "windows": { "command": ".\\mvnw.cmd clean package -DskipTests" },
      "options": { "cwd": "${workspaceFolder}/Backend" },
      "problemMatcher": ["$maven"],
      "detail": "Package the backend jar"
    },
    {
      // Public HTTPS URL for PayFast's callback (ITN) to reach localhost:8080.
      // --metrics is pinned because the backend reads the tunnel's current
      // hostname from http://127.0.0.1:20241/quicktunnel (see
      // app.payfast.tunnel-discovery-url). Needs cloudflared installed - README,
      // "Payments (PayFast)". The tunnel outlives the debug session, so a second F5
      // would collide on port 20241: if one is already answering there it is reused
      // (the echo matches endsPattern and the task exits 0). "Tasks: Terminate Task"
      // stops it.
      "label": "payfast: tunnel",
      "type": "shell",
      "command": "if curl -fsS --max-time 2 http://127.0.0.1:20241/quicktunnel; then echo; echo 'Tunnel already running - reusing it (Registered tunnel connection)'; else exec cloudflared tunnel --url http://localhost:8080 --metrics 127.0.0.1:20241; fi",
      "windows": {
        "command": "cloudflared tunnel --url http://localhost:8080 --metrics 127.0.0.1:20241"
      },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "reveal": "silent" },
      "problemMatcher": {
        "owner": "cloudflared",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activeBegins": true,
          "beginsPattern": "^__never_matches__$",
          // Ready once the tunnel can actually carry traffic, not merely requested.
          "endsPattern": "Registered tunnel connection"
        }
      },
      "detail": "cloudflared quick tunnel so PayFast can confirm sandbox top-ups locally"
    },
    {
      "label": "full stack: verify",
      "dependsOrder": "sequence",
      "dependsOn": ["backend: test", "frontend: lint", "frontend: build"],
      "problemMatcher": [],
      "detail": "Everything that must pass before opening a pull request"
    }
  ]
}
